CREATE TABLE airbnb (
    id Uint64,
    name Utf8,
    host_id Utf8,
    host_identity_verified Utf8,
    host_name Utf8,
    neighbourhood_group Utf8,
    neighbourhood Utf8,
    lat Utf8,
    lon Utf8,
    country Utf8,
    country_code Utf8,
    instant_bookable Utf8,
    cancellation_policy Utf8,
    room_type Utf8,
    construction_year Utf8,
    price Utf8,
    service_fee Utf8,
    minimum_nights Utf8,
    number_of_reviews Utf8,
    last_review Utf8,
    reviews_per_month Utf8,
    review_rate_number Utf8,
    calculated_host_listings_count Utf8,
    availability_365 Utf8,
    house_rules Utf8,
    license Utf8,
    PRIMARY KEY (id)
);